# Copy this file to .env.admin.local in the project root.
# .env.admin.local is git-ignored. Delete it after account provisioning.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the legacy service-role key or the newer secret key, never both.
SUPABASE_SERVICE_ROLE_KEY=PASTE_ONLY_IN_YOUR_LOCAL_IGNORED_FILE
# SUPABASE_SECRET_KEY=PASTE_ONLY_IN_YOUR_LOCAL_IGNORED_FILE

# Optional: override the temporary faculty/club password used only when an
# account is created or --reset-passwords is passed. The default is METCAMPUS.
# MET_STAFF_INITIAL_PASSWORD=METCAMPUS
